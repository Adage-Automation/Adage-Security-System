# Database (Supabase Postgres, Mumbai/ap-south-1 region recommended — see
# docs/deployment.md#setting-up-supabase; use the connection string from
# Project Settings > Database, the "Transaction" pooler string for the app)
DATABASE_URL="postgresql://user:password@localhost:5432/adage_security?schema=public"

# Sessions
SESSION_SECRET="change-me-to-a-long-random-string"

# App
APP_TIMEZONE="Asia/Kolkata"
PORT=4000
FRONTEND_URL="http://localhost:5173"
NODE_ENV="development"

# Email — sent via the Microsoft Graph API (OAuth2 client-credentials),
# through Adage's existing Microsoft 365 tenant for adage-automation.com,
# not a third-party transactional-email vendor. Not SMTP: Microsoft 365
# retired basic-auth SMTP AUTH, so this requires an Azure AD app
# registration instead of a mailbox password. See
# docs/email-m365-admin-handoff.md for exactly what to request from
# whoever administers Microsoft 365/Azure, and docs/decisions.md for why.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
MAIL_FROM_ADDRESS="security@adage-automation.com"
SECURITY_EMAIL="security@adage-automation.com"

# Object storage — Supabase Storage recommended (same project as the DB
# above, S3-compatible API; see Project Settings > Storage > S3 Connection).
# Any other S3-compatible provider (AWS S3, Cloudflare R2) also works.
STORAGE_ENDPOINT=
STORAGE_REGION="auto"
STORAGE_BUCKET="adage-security-reports"
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=
